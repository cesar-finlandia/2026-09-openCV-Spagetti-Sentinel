# Spaghetti Sentinel — copy to .env and fill. NEVER commit .env (REQ-N07).
# Vision backend: "cool" (COOL build on Graviton) or "baseline" (stock OpenCV 5).
SS_BACKEND=cool
# Offline replay: 1 = golden cached frames only, no AWS, no network.
SS_REPLAY=0

# AWS — the meaningful cloud component (brief §4 MT-4).
AWS_REGION=us-east-1
S3_BUCKET=
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Local paths
SS_EVIDENCE_DIR=.evidence
SS_CACHE_DIR=.golden-cache
SS_FIXTURES_DIR=fixtures

# Run shape
SS_MAX_FRAMES=900
SS_SAMPLE_EVERY_N=3
SS_WARN_THRESHOLD=0.45
SS_PAUSE_THRESHOLD=0.72
SS_CONFIDENCE_FLOOR=0.55
SS_LLM_BUDGET_USD=5.0

# Stamped by deploy/build_and_push.sh — do not edit by hand.
BUILD_MARKER=dev
